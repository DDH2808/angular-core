{
  "name": "angular-core",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "check-types": "tsc --pretty --noEmit",
    "pre-commit": "npm run check-types && npm run lint:fix && npm run prettier:fix",
    "test-all": "npm run check-types && npm run lint:fix && npm run prettier && npm run build ",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,scss}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.2.0",
    "@angular/cdk": "17.2.0",
    "@angular/common": "^17.2.0",
    "@angular/compiler": "^17.2.0",
    "@angular/core": "^17.2.0",
    "@angular/forms": "^17.2.0",
    "@angular/platform-browser": "^17.2.0",
    "@angular/platform-browser-dynamic": "^17.2.0",
    "@angular/router": "^17.2.0",
    "@auth0/angular-jwt": "5.2.0",
    "@ckeditor/ckeditor5-angular": "7.0.1",
    "@ckeditor/ckeditor5-build-classic": "41.3.1",
    "@ckeditor/ckeditor5-core": "41.3.1",
    "@ckeditor/ckeditor5-engine": "41.3.1",
    "@ckeditor/ckeditor5-image": "41.3.1",
    "@ckeditor/ckeditor5-utils": "41.3.1",
    "@ckeditor/ckeditor5-watchdog": "41.3.1",
    "@ctrl/ngx-emoji-mart": "^9.2.0",
    "@ctrl/tinycolor": "^4.1.0",
    "@jsverse/transloco": "^7.1.0",
    "@ng-select/ng-select": "^12.0.7",
    "@types/lodash": "^4.14.191",
    "angular-mentions": "1.5.0",
    "bootstrap": "^5.3.2",
    "date-fns": "^2.30.0",
    "dom-to-image": "^2.6.0",
    "echarts": "5.5.0",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "ng-otp-input": "^1.9.3",
    "ng-zorro-antd": "^17.4.1",
    "ng2-ckeditor": "^1.3.6",
    "ngx-bootstrap": "^12.0.0",
    "ngx-mask": "^17.0.4",
    "ngx-scrollbar": "13.0.3",
    "ngx-skeleton-loader": "^9.0.0",
    "ngx-toastr": "^18.0.0",
    "primeng": "17.13.0",
    "rxjs": "~7.8.0",
    "smaxapp": "17.0.2",
    "socket.io-client": "4.7.4",
    "tslib": "^2.3.0",
    "uuid": "^8.3.2",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.2.2",
    "@angular-eslint/builder": "17.2.1",
    "@angular-eslint/eslint-plugin": "17.2.1",
    "@angular-eslint/eslint-plugin-template": "17.2.1",
    "@angular-eslint/schematics": "17.2.1",
    "@angular-eslint/template-parser": "17.2.1",
    "@angular/cli": "^17.2.2",
    "@angular/compiler-cli": "^17.2.0",
    "@types/dom-to-image": "^2.6.7",
    "@types/jasmine": "~5.1.0",
    "@types/jquery": "3.5.18",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "6.19.0",
    "@typescript-eslint/parser": "6.19.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.1.1",
    "typescript": "~5.3.2"
  }
}
